extends RefCounted
## A level: size, platforms, spawns. Mirrors src/ballbrawlla/world/level.py.
## Four boundary walls (floor, ceiling, left, right) are added in front of the platforms, as in Python.

const Box = preload("res://scripts/box.gd")
const SOLID := "solid"
const THIN := "thin"

class Platform:
	var rect
	var kind: String = "platform"          # "platform" or "bound"; only affects rendering
	var platform_type: String = "solid"    # "solid" blocks from all sides; "thin" is one-way
	func is_thin() -> bool:
		return platform_type == "thin"

var width: float
var height: float
var wall_thickness: float = 32.0
var platforms: Array = []          # Platform, boundaries first
var solids: Array = []             # Box
var thin: Array = []               # Box
var player_spawns: Array = []      # [x, y] pairs
var ball_spawn: Array = [200.0, 100.0]
var level_name: String = "untitled"
var yard_px: float = -1.0          # -1 = use Tuning.yard_px (Python: None)

func has_yard_px() -> bool:
	return yard_px > 0.0

## Inverse of parse() (the boundary walls are regenerated by the receiver, so they are omitted): the "level" in a
## host's welcome message.
func to_dict() -> Dictionary:
	var plats: Array = []
	for p in platforms:
		if p.kind != "platform":
			continue
		var d := {"x": p.rect.x, "y": p.rect.y, "w": p.rect.w, "h": p.rect.h}
		if p.is_thin():
			d["type"] = "thin"
		plats.append(d)
	var out := {"name": level_name, "width": width, "height": height, "wall_thickness": wall_thickness,
			"player_spawns": player_spawns, "ball_spawn": ball_spawn, "platforms": plats}
	if has_yard_px():
		out["yard_px"] = yard_px
	return out

func spawn_for(index: int) -> Array:
	return player_spawns[index % player_spawns.size()].duplicate()

## Parse a level dictionary. Returns {"level": Level or null, "error": String}. The error text mirrors Python's.
static func parse(data: Dictionary, stem: String = "") -> Dictionary:
	var lv = load("res://scripts/level.gd").new()
	for key in ["width", "height", "platforms", "ball_spawn"]:
		if not data.has(key):
			return {"level": null, "error": "missing '%s'" % key}
	if not (data.has("player_spawns") or data.has("player_spawn")):
		return {"level": null, "error": "missing 'player_spawn'"}
	lv.width = float(data["width"])
	lv.height = float(data["height"])
	lv.wall_thickness = float(data.get("wall_thickness", 32))
	lv.level_name = String(data.get("name", stem if stem != "" else "untitled"))
	var spawns = data.get("player_spawns")
	if spawns == null or spawns.is_empty():
		spawns = [data["player_spawn"]]
	for s in spawns:
		lv.player_spawns.append([float(s[0]), float(s[1])])
	lv.ball_spawn = [float(data["ball_spawn"][0]), float(data["ball_spawn"][1])]
	if data.has("yard_px") and data["yard_px"] != null:
		var v = data["yard_px"]
		if typeof(v) == TYPE_BOOL or not (typeof(v) == TYPE_INT or typeof(v) == TYPE_FLOAT) or not (float(v) > 0.0):
			return {"level": null, "error": "invalid yard_px %s (expected a positive number)" % str(v)}
		lv.yard_px = float(v)
	var t: float = lv.wall_thickness
	var w: float = lv.width
	var h: float = lv.height
	for r in [Box.new(0, h - t, w, t), Box.new(0, 0, w, t), Box.new(0, 0, t, h), Box.new(w - t, 0, t, h)]:
		var p := Platform.new()
		p.rect = r
		p.kind = "bound"
		lv.platforms.append(p)
	for pd in data["platforms"]:
		var ptype: String = String(pd.get("type", "solid"))
		if ptype != SOLID and ptype != THIN:
			return {"level": null, "error": "invalid platform type '%s' (expected 'thin' or 'solid')" % ptype}
		var p := Platform.new()
		p.rect = Box.new(float(pd["x"]), float(pd["y"]), float(pd["w"]), float(pd["h"]))
		p.platform_type = ptype
		lv.platforms.append(p)
	for p in lv.platforms:
		if p.is_thin():
			lv.thin.append(p.rect)
		else:
			lv.solids.append(p.rect)
	return {"level": lv, "error": ""}

## Load res://levels/<stem>.json (or any path). Returns the same {"level", "error"} dictionary as parse().
static func load_file(path: String) -> Dictionary:
	if not FileAccess.file_exists(path):
		return {"level": null, "error": "file not found: %s" % path}
	var text := FileAccess.get_file_as_string(path)
	var json := JSON.new()
	if json.parse(text) != OK:
		return {"level": null, "error": "not valid JSON (%s, line %d)" % [json.get_error_message(), json.get_error_line()]}
	if typeof(json.data) != TYPE_DICTIONARY:
		return {"level": null, "error": "not a level (expected a JSON object)"}
	return parse(json.data, path.get_file().get_basename())
